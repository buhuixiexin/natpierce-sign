# 皎月签到推送通知配置
#
# 至少配置一个推送渠道，推荐使用邮箱（完全免费）
#
# --- 邮箱推送（推荐，免费）---
# QQ邮箱: 登录QQ邮箱 → 设置 → 账户 → 开启 POP3/SMTP → 获取授权码
# 163邮箱: 登录163邮箱 → 设置 → POP3/SMTP/IMAP → 开启 → 获取授权码
MAIL_USER=
MAIL_PASS=
# MAIL_TO=               # 可选，收件邮箱，默认同发件邮箱
# MAIL_SMTP_HOST=        # 可选，自动识别 QQ/163/126/Gmail/Outlook
# MAIL_SMTP_PORT=        # 可选，自动识别

# --- Server酱推送 ---
# https://sct.ftqq.com
# NATPIERCE_SCT_KEY=

# --- Telegram Bot 推送 ---
# NATPIERCE_TG_BOT_TOKEN=
# NATPIERCE_TG_CHAT_ID=

# --- Bark (iOS) 推送 ---
# NATPIERCE_BARK_KEY=
